rules_version = '2';

// Reglas de seguridad de Firestore para Family Steam.
// Se pegan en Firebase Console → Firestore Database → Reglas → Publicar.
// - Solo se aceptan operaciones con sesión anónima iniciada (la abre la página).
// - Cada documento se valida: campos permitidos, tipos, miembro existente y rangos razonables.
// - Cualquier otra colección queda cerrada.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validMember(memberId) {
      return memberId in ['thewolf', 'phanlu', 'poetahalley', 'zabatiel', 'yeonat', 'piratadesopa'];
    }

    function validAppId(appId) {
      return appId is string && appId.matches('^[0-9]{1,10}$');
    }

    function validTitle(title) {
      return title is string && title.size() > 0 && title.size() <= 150;
    }

    function validDate(date) {
      return date is string && date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // Portada opcional: cualquier imagen https (Steam o pegada a mano).
    function validCover(d) {
      return !('coverUrl' in d)
        || (d.coverUrl is string && d.coverUrl.size() <= 500 && d.coverUrl.matches('^https://[^ ]+$'));
    }

    function validPurchase(d) {
      return d.keys().hasOnly(['appId', 'title', 'memberId', 'amount', 'date', 'coverUrl'])
        && validCover(d)
        && d.keys().hasAll(['appId', 'title', 'memberId', 'amount', 'date'])
        && validAppId(d.appId)
        && validTitle(d.title)
        && validMember(d.memberId)
        && d.amount is number && d.amount > 0 && d.amount <= 5000
        && validDate(d.date);
    }

    function validPlanned(d) {
      return d.keys().hasOnly(['appId', 'title', 'memberId', 'createdAt', 'coverUrl'])
        && validCover(d)
        && d.keys().hasAll(['appId', 'title', 'memberId', 'createdAt'])
        && validAppId(d.appId)
        && validTitle(d.title)
        && validMember(d.memberId)
        && validDate(d.createdAt);
    }

    match /purchases/{purchaseId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && validPurchase(request.resource.data);
    }

    match /planned/{plannedId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && validPlanned(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
